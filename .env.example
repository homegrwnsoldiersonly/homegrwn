# Google Ads API credentials for account ingestion.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Nothing here is committed. See src/lib/ads/config.ts.

# OAuth 2.0 client from a Google Cloud project (APIs & Services > Credentials).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Developer token from your Google Ads MANAGER (MCC) account.
# Requires Google approval; "Basic" access is enough to read linked accounts.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Refresh token minted once via the OAuth consent flow for the above client.
GOOGLE_ADS_REFRESH_TOKEN=

# The manager (MCC) account id that has access to the accounts you query.
# Digits only or dashed — both are accepted. Optional but usually required.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Default account to pull when a call doesn't specify one. Optional.
GOOGLE_ADS_CUSTOMER_ID=
